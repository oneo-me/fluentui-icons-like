{
  "name": "@oneo/fluentui-icons-like-react",
  "version": "2.1.0-preview.0",
  "description": "Microsoft Fluent UI System Icons as tree-shakable React SVG components.",
  "author": "ONEO",
  "license": "MIT",
  "homepage": "https://github.com/oneo-me/fluentui-icons-like#readme",
  "bugs": "https://github.com/oneo-me/fluentui-icons-like/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneo-me/fluentui-icons-like.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "fluentui",
    "fluent-ui",
    "fluent",
    "icons",
    "icon",
    "svg",
    "svg-icons",
    "microsoft",
    "system-icons",
    "tree-shakable"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build",
    "pack": "pnpm pack",
    "publish": "pnpm publish"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "files": [
    "README.md",
    "logo.png",
    "screenshot.png",
    "dist/**"
  ],
  "sideEffects": false
}
