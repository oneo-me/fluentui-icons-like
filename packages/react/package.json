{
  "name": "@oneo/fluentui-icons-like-react",
  "version": "2.0.1",
  "description": "Microsoft Fluent UI System Icons as tree-shakable React SVG components.",
  "author": "ONEO",
  "license": "MIT",
  "homepage": "https://github.com/oneo-me/fluentui-icons-like#readme",
  "bugs": "https://github.com/oneo-me/fluentui-icons-like/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneo-me/fluentui-icons-like.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "fluentui",
    "fluent-ui",
    "fluent",
    "icons",
    "icon",
    "svg",
    "svg-icons",
    "microsoft",
    "system-icons",
    "tree-shakable"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check --write && tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build",
    "pack": "pnpm pack",
    "publish": "pnpm publish"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/react": "^19.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "files": [
    "README.md",
    "logo.png",
    "screenshot.png",
    "dist/**"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
