{
  "name": "@oneo/fluentui-icons-like",
  "version": "2.1.1",
  "description": "Microsoft Fluent UI System Icons as Svelte 5 runes-mode components. Tree-shakable, type-safe SVG icons with zero dependencies — import only what you need.",
  "author": "ONEO",
  "license": "MIT",
  "homepage": "https://github.com/oneo-me/fluentui-icons-like#readme",
  "bugs": "https://github.com/oneo-me/fluentui-icons-like/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneo-me/fluentui-icons-like.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "fluentui",
    "fluent-ui",
    "fluent",
    "icons",
    "icon",
    "svg",
    "svg-icons",
    "microsoft",
    "system-icons",
    "tree-shakable",
    "runes-mode"
  ],
  "type": "module",
  "scripts": {
    "build": "svelte-package -i src/lib/icons",
    "prepack": "pnpm run build && publint",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "pack": "pnpm pack",
    "publish": "pnpm publish"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@types/node": "^26.2.0",
    "publint": "^0.3.23",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    }
  },
  "files": [
    "screenshot.png",
    "README.md",
    "logo.png",
    "dist/**"
  ],
  "sideEffects": false
}
