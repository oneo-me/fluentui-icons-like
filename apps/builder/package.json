{
  "name": "builder",
  "version": "1.0.0",
  "description": "CLI tool for building @oneo/fluentui-icons-like",
  "type": "module",
  "bin": {
    "builder": "./dist/index.js"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "sync": "bun src/index.ts sync",
    "generate": "bun src/index.ts generate",
    "pack": "bun src/index.ts pack"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
